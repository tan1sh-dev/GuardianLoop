# =============================================================================
# GuardianLoop secrets — never commit this file with real values
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini API keys — required for the Fixer (and Classifier's optional LLM path)
# -----------------------------------------------------------------------------
# Free-tier Gemini accounts have strict daily quotas. GuardianLoop supports
# multi-key rotation: when one key hits a 429 quota, the Fixer transparently
# rotates to the next available key. There are two equivalent ways to register
# additional keys:
#
#   (1) Numbered slots — simple, explicit:
GOOGLE_API_KEY=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
# GOOGLE_API_KEY_4=
#   (… up to GOOGLE_API_KEY_20)
#
#   (2) Bulk list — comma-separated, convenient for many keys:
# GOOGLE_API_KEYS=keyA,keyB,keyC
#
# Both forms can be mixed; duplicates are de-duped automatically. If every key
# is exhausted in the same run, the Fixer falls back from gemini-2.5-pro to
# gemini-2.5-flash (configurable via config.yaml::fixer_fallback_model) before
# giving up on a finding.

# -----------------------------------------------------------------------------
# Optional — raises NVD CVE-lookup rate limit from 5/30s to 50/30s
# -----------------------------------------------------------------------------
NVD_API_KEY=

# -----------------------------------------------------------------------------
# Required only if running the GitHub webhook server
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Optional but strongly recommended — enables full Semgrep ruleset including
# C/C++. Get a free token: run `semgrep login` in WSL, then copy the token
# from ~/.semgrep/settings.yml, or generate one at:
#   https://semgrep.dev/orgs/-/settings/tokens
# -----------------------------------------------------------------------------
SEMGREP_APP_TOKEN=
